export PATH=$JAVA_HOME/bin:$PATH
cd account-service
./gradlew clean build
nohup ./gradlew bootrun --args='--spring.profiles.active=local' > server.log 2>&1 &



cd transaction-service
./gradlew clean build
nohup ./gradlew bootrun --args='--spring.profiles.active=local' > server.log 2>&1 &


cd api-gateway
./gradlew clean build
nohup ./gradlew bootrun --args='--spring.profiles.active=local' > server.log 2>&1 &


source .venv/bin/activate
cd statement-loader
nohup python run.py --app-profile local > server.log 2>&1 & </dev/null &


cd finance-manager-ui
nohup ionic serve --external --no-open --no-open > server.log 2>&1 & </dev/null &
disown
ionic serve  --no-open --external